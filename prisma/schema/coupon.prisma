model Coupon {
    id             String     @id @default(cuid())
    code           String     @unique
    description    String?
    type           CouponType
    value          Float
    minOrderAmount Float?
    maxDiscount    Float?
    usageLimit     Int?
    usedCount      Int        @default(0)
    perUserLimit   Int        @default(1)
    isActive       Boolean    @default(true)
    startsAt       DateTime?
    expiresAt      DateTime?
    createdAt      DateTime   @default(now())
    updatedAt      DateTime   @updatedAt

    orders Order[]
    carts  Cart[]

    @@map("coupons")
}
