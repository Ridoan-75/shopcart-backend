model Address {
    id         String   @id @default(cuid())
    userId     String
    label      String?
    fullName   String
    phone      String
    street     String
    city       String
    state      String
    country    String
    postalCode String
    isDefault  Boolean  @default(false)
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    orders Order[]

    @@map("addresses")
}
